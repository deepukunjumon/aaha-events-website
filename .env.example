# Base44 app id, from `base44 link`.
VITE_BASE44_APP_ID=

# Base URL of the Base44 backend this app talks to. Only needed to point the
# dev server at a specific deployment; base44 dev sets this for you.
VITE_BASE44_APP_BASE_URL=

# Pins backend functions to a specific published version instead of latest.
VITE_BASE44_FUNCTIONS_VERSION=
