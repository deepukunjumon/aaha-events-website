{
  "name": "Partner",
  "description": "Vendors and venues in the logo marquee.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Partner name"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort order",
      "default": 1
    },
    "published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}