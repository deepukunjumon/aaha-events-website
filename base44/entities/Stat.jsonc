{
  "name": "Stat",
  "description": "Numbers shown in the animated trust strip.",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "title": "Number"
    },
    "suffix": {
      "type": "string",
      "title": "Suffix",
      "description": "e.g. + or %"
    },
    "label": {
      "type": "string",
      "title": "Label"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort order",
      "default": 1
    }
  },
  "required": [
    "value",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}