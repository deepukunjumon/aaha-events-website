{
  "name": "Testimonial",
  "description": "Client reviews shown in the home carousel and service pages.",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "title": "Client name"
    },
    "event_type": {
      "type": "string",
      "title": "Event type"
    },
    "quote": {
      "type": "string",
      "title": "Quote"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1\u20135)",
      "default": 5
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL"
    },
    "video_url": {
      "type": "string",
      "title": "Video testimonial URL"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort order",
      "default": 1
    },
    "published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    }
  },
  "required": [
    "quote"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}